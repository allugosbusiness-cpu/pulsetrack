# Frontend API Configuration
# =================================
# 
# This file configures the API endpoint for the PulseTrack web frontend.
# 
# USAGE:
# 1. Copy this file to .env.local
# 2. Update VITE_API_BASE_URL with your backend server address
# 3. Restart the development server
#
# EXAMPLES:
#
# Local Development (backend on same machine):
# VITE_API_BASE_URL=http://localhost:8000/api
#
# Same Network (backend on different machine in your LAN):
# VITE_API_BASE_URL=http://192.168.1.100:8000/api
#
# Remote Server:
# VITE_API_BASE_URL=https://api.pulsetrack.example.com/api
#
# =================================

# Backend API Base URL
# Replace with your actual backend server address
VITE_API_BASE_URL=http://localhost:8000/api

# Optional: Set environment mode
# Values: 'development' or 'production'
VITE_ENVIRONMENT=development

# Optional: Enable debug logging
VITE_DEBUG=true
