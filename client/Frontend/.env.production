# Production Environment Variables for PulseTrack Frontend (Vercel)
# This file configures the frontend to use the Render backend

# Use the live Render backend.
# NOTE: apiConfig.js appends /api/v1 automatically — keep these as the bare host
# (no /api suffix) to avoid a doubled /api/api/v1 path.
VITE_BACKEND_URL=https://pulsetrack-uh6i.onrender.com
VITE_API_BASE_URL=https://pulsetrack-uh6i.onrender.com

# Analytics (optional)
VITE_ENABLE_ANALYTICS=true

# API timeout settings
VITE_API_TIMEOUT=60000
